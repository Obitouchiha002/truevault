<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions policy: TrueVault requests nothing at install time.

      Photos and videos are selected through the Android Photo Picker, and documents through the
      Storage Access Framework. Both hand back a URI the user explicitly chose, so no storage
      permission is needed. MANAGE_EXTERNAL_STORAGE is never requested.

      USE_BIOMETRIC is the only permission declared, and only because BiometricPrompt requires it.
      It is a normal permission: it shows no runtime dialog and grants no access to biometric data.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      What libraries merge in, and what is done about it.

      androidx.biometric 1.1.0 adds USE_FINGERPRINT because below API 28 it falls back to
      FingerprintManager. minSdk is 26, so it is genuinely needed and is kept. Normal permission,
      no runtime prompt, and it is disclosed in the Privacy Policy.

      The next two are removed rather than tolerated. media3-exoplayer merges ACCESS_NETWORK_STATE
      and WAKE_LOCK into every app that depends on it, for adaptive streaming and for holding the
      CPU awake during background playback. TrueVault plays only local decrypted files and never
      plays in the background, so it uses neither. Leaving them would put "network" in the
      permission list of an app whose whole claim is that nothing leaves the device — and a user who
      checks that list would be right to stop believing the claim.

      If streaming or background playback is ever added, these come back, and the Privacy Policy and
      legal/data-practices-inventory.md are updated in the same commit.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".TrueVaultApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher_nexa"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_nexa_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.TrueVault.Splash"
        tools:targetApi="34">

        <!--
          The share sheet shows the *activity's* label and icon, not the alias the user launched
          from. Without these two lines a file shared from a file manager offered the old name and
          the old icon, which gave the cover away at exactly the moment someone was using it.
        -->
        <activity
            android:name=".MainActivity"
            android:icon="@mipmap/ic_launcher_nexa"
            android:roundIcon="@mipmap/ic_launcher_nexa_round"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:theme="@style/Theme.TrueVault.Splash"
            android:windowSoftInputMode="adjustResize">
            <!--
              Receiving a share is how a file gets in from anywhere on the phone: the gallery, a file
              manager, a chat app, a browser download. Without this, a user has to come to TrueVault
              first and go looking for the file, which is the wrong way round for the common case.

              `*/*` because a vault that only accepted images would be a photo vault. Sharing an
              item grants read access to it and nothing else — no storage permission is involved, and
              nothing outside what the user picked becomes reachable.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Launcher identities.

          MainActivity itself has no LAUNCHER intent filter — these aliases carry it, so exactly one
          of them decides what the home screen shows. TrueVaultAlias ships enabled; the rest are off
          until the user chooses one in Settings -> Appearance.

          What this changes: the icon and the name in the launcher, and which screen opens first.
          What it does NOT change: the app remains fully visible in Android Settings, storage usage,
          battery usage and permission controls. The Appearance screen says exactly that, because an
          app that let someone believe otherwise would be putting them at risk on a false promise.

          Every identity below belongs to this product. None imitates Android, Google, a
          manufacturer, a bank, an antivirus or another developer's app.
        -->
        <activity-alias
            android:name=".launcher.TrueVaultAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nexa"
            android:roundIcon="@mipmap/ic_launcher_nexa_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.NexaAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nexa"
            android:roundIcon="@mipmap/ic_launcher_nexa_round"
            android:label="@string/appearance_label_nexa"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.NexaNotesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nexa"
            android:roundIcon="@mipmap/ic_launcher_nexa_round"
            android:label="@string/appearance_label_nexa_notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.NexaFilesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nexa"
            android:roundIcon="@mipmap/ic_launcher_nexa_round"
            android:label="@string/appearance_label_nexa_files"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          Secure Launcher Mode's Home activity.

          Declaring it is what lets a user choose TrueVault as their launcher at all; the app never
          requests the Home role on its own, and the feature stays off until it is enabled from
          Settings -> Advanced Privacy. It shows app icons only and never vault content.
        -->
        <!--
          Disabled at install time, on purpose.

          Declaring category.HOME makes an app a candidate launcher, and Android then asks the user
          to choose a home app every time they press Home. Shipping that enabled would force the
          launcher question on every user who never asked for Secure Launcher Mode. The component is
          switched on only when the user turns that mode on, and switched off again when they turn
          it off — see SecureLauncherComponent.
        -->
        <activity
            android:name=".SecureLauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density"
            android:theme="@style/Theme.TrueVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Not exported, permission-gated, and limited to one cache subdirectory (see file_paths.xml).
          It exists only so a share can hand one temporary decrypted file to an app the user picked.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
