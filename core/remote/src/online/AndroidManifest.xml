<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged only when `supabase.properties` exists — see this module's build script.

  Adding this permission changes what the app is. Before shipping a build that merges it, the
  Privacy Policy, the Play Data Safety form, the website and the README must all be rewritten:
  each of them currently states that the app has no internet permission. docs/ADMIN.md has the list.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
